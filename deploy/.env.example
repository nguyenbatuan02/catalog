# ============================================================
# Catalog API — .env cho VPS MỚI
# Copy thành .env ở thư mục gốc project rồi điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit file .env lên git.
# ============================================================

# ─── Server ─────────────────────────────────────────────────
PORT=3001
# 0.0.0.0 = ai cũng vào được. Nếu chạy sau Nginx thì để 127.0.0.1
# cho an toàn — xem mục "Bảo mật" trong README.
HOST=0.0.0.0
NODE_ENV=production

# ─── PostgreSQL (DB MỚI) ────────────────────────────────────
# Đây là dòng DUY NHẤT quyết định app dùng DB nào.
# Đổi DB_NAME là chuyển DB, không phải sửa code.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalog
DB_USER=catalog_user
DB_PASSWORD=                      # ĐẶT MẬT KHẨU MẠNH, đừng dùng lại devpassword
DB_MAX_CONNECTIONS=20

# ─── OpenAI (Chat AI + đọc VIN từ ảnh) ──────────────────────
# Dùng cho POST /api/ai/chat và POST /api/ai/vision
OPENAI_API_KEY=

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=

# ─── Bravo (SQL Server) — giá bán + tồn kho ─────────────────
# Bỏ trống nếu VPS mới chưa nối được sang Bravo.
# Code load mssql theo kiểu lazy nên thiếu cũng KHÔNG làm chết server,
# chỉ là không có giá.
BRAVO_SS_HOST=
BRAVO_SS_PORT=1992
BRAVO_SS_DB=
BRAVO_SS_USER=
BRAVO_SS_PASSWORD=
BRAVO_DEFAULT_KH=
BRAVO_BRANCH=
BRAVO_CACHE_TTL_MIN=10

# ─── CORS ───────────────────────────────────────────────────
# Điền domain thật sẽ gọi vào API, cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3000
