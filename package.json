    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "mssql": "^11.0.1",
    "pg": "^8.12.0",
    "pino-pretty": "^13.1.3",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
