# ============================================================
# Catalog API — Environment Variables
# Copy file này thành .env và điền giá trị thật
# ============================================================

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL — cùng DB với ZaloCRM
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zalocrm
DB_USER=crmuser
DB_PASSWORD=dien-mat-khau-that-o-day
DB_MAX_CONNECTIONS=10

# JWT — dùng chung secret với ZaloCRM để validate token
JWT_SECRET=your-jwt-secret-same-as-zalocrm

# Bravo API
BRAVO_API_URL=https://your-bravo-domain.com
BRAVO_API_KEY=your-bravo-api-key
BRAVO_CACHE_TTL_MIN=5

# CORS — cho phép ZaloCRM gọi vào
CORS_ORIGINS=http://localhost:3000,https://your-zalocrm-domain.com
